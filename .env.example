# UNITED — environment template.
# Copy to .env and fill in real values. NEVER commit the filled-in .env.
#
# In production the server refuses to start unless every REQUIRED variable below
# is set (see lib/env.ts) — a missing secret fails loudly at boot instead of
# silently falling back to something insecure.

# ---------------------------------------------------------------------------
# REQUIRED — the app will not start in production without these
# ---------------------------------------------------------------------------

# Pooled Postgres connection used by the app at runtime.
# Supabase Dashboard -> Connect -> ORMs -> Prisma.
# Use the SESSION pooler (port 5432), not the transaction pooler (6543):
# session mode keeps prepared statements safe and measured ~4.6x faster here.
# Keep connection_limit within the project's pooler budget (see README).
DATABASE_URL=

# Secret used to sign the session JWT (cookie "united_session").
# Must be a long, random, private string — anyone who knows it can forge a
# SUPER_ADMIN session. Generate with: openssl rand -base64 48
# Rotating it immediately invalidates every signed-in session.
JWT_SECRET=

# Key the two-step sign-in (TOTP) secrets are encrypted with at rest (AES-256-GCM,
# key derived with HKDF). At least 32 random characters; production refuses to boot
# without it. Generate with: openssl rand -base64 48
# Keep it in the same secret store as JWT_SECRET and back it up separately from the
# database: a database backup restored WITHOUT this key leaves every enrolled user
# unable to pass the second step (an administrator then resets their MFA). Changing it
# has the same effect — there is no automatic re-encryption.
MFA_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# REQUIRED FOR DATABASE MIGRATIONS (prisma migrate deploy)
# ---------------------------------------------------------------------------

# Direct (non-pooled, port 5432) connection. Prisma Migrate needs this for DDL,
# which cannot run through the transaction pooler. Referenced by schema.prisma.
DIRECT_URL=

# ---------------------------------------------------------------------------
# REQUIRED FOR THE n8n / Hermes ORDER INTAKE INTEGRATION
# ---------------------------------------------------------------------------

# Shared secret for POST /api/orders via the "x-api-key" header.
# Fails closed: if unset, every API-key order-creation request is rejected 401,
# so the app stays safe but automated order intake stops working.
N8N_API_KEY=

# ---------------------------------------------------------------------------
# DOCUMENT ATTACHMENTS (Supabase Storage)
# ---------------------------------------------------------------------------

# Production stores attachment bytes in Supabase Storage. Create a PRIVATE bucket
# (Dashboard -> Storage -> New bucket, "Public" off); downloads always go through
# the app's own permission check. The service-role key is a server secret.
# Without these, uploads/downloads answer 503 — files are never kept on local disk
# in production.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=erp-attachments

# STORAGE_PROVIDER   supabase (production default) | local (development default)
# LOCAL_STORAGE_DIR  directory for STORAGE_PROVIDER=local (default ./storage, gitignored)

# ---------------------------------------------------------------------------
# OPTIONAL — set by the platform or only used for debugging
# ---------------------------------------------------------------------------

# NODE_ENV          set to "production" automatically by `next build` / `next start`
# NEXT_DIST_DIR     optional build-directory override, for building a smoke-test
#                   copy alongside a running dev server
# PRISMA_LOG_QUERIES set to 1 to emit every SQL query as an event (noisy; off by default)
# BASE              test-harness only — base URL the regression suites run against
# BACKUP_MARKER_FILE optional — path of the marker file scripts/ops/backup-pg-dump.sh
#                   rewrites after each successful backup; GET /api/health/deep reports
#                   its age (docs/erp/OPERATIONS_RUNBOOK.md)

# ETA e-invoicing (Egyptian Tax Authority). Leave empty until UNITED is registered on the
# ETA portal; submission stays disabled while any of these is empty. Values come from the
# ETA portal (ERP system registration) and the e-seal signing bridge — never commit them.
ETA_ENV=
ETA_API_BASE_URL=
ETA_ID_SERVER_URL=
ETA_CLIENT_ID=
ETA_CLIENT_SECRET=
ETA_SIGNER_URL=
ETA_SIGNER_TOKEN=
